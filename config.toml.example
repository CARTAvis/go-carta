# CARTA Go Configuration Example
# Copy this file to /etc/carta/config.toml and adjust values as needed
# Configuration can also be set via environment variables with CARTA_ prefix
# Example: CARTA_CONTROLLER_PORT=8081

# ============================================================================
# Global Settings
# ============================================================================

# Environment mode: development, production, etc.
environment = "development"

# Logging level: debug, info, warn, error
log_level = "info"

# ============================================================================
# Controller Configuration
# ============================================================================
[controller]

# Authentication mode: "none", "pam", "oidc", or "both"
# - none: No authentication required
# - pam: Use PAM (Pluggable Authentication Modules) for system user authentication
# - oidc: Use OpenID Connect for authentication
# - both: Allow both PAM and OIDC authentication
auth_mode = "none"

# Port for the controller HTTP/WebSocket server
port = 8081

# Hostname to bind to. If this is empty, all interfaces will be used
hostname = ""

# Directory containing the CARTA frontend static files
# If empty, the controller will not serve the frontend
frontend_dir = ""

# Address of the spawner service. If this is empty, the controller will determine the address from the spawner hostname and port
spawner_address = "http://localhost:8080"

# If exposing the controller to users other than at the top level of a domain the controller must tell the frontend where to find interfaces
# - If the controller is accessed at http://mydomain.tld/ the default should suffice
# - If the controller is accessed at, e.g., http://mydomain.tld/carta/ this should then be set to "/carta/api"
api_prefix = "/api"

# ----------------------------------------------------------------------------
# Login Page Configuration
# ----------------------------------------------------------------------------
[controller.login_page]

# Title displayed alongside the CARTA logo on the login page
title = "CARTA"

# Welcome / instruction text shown below the logo
welcome_text = "Welcome to the CARTA server."

# Path to an optional site banner image displayed at the top of the login page.
# Leave empty for no banner.
site_banner = ""

# Optional support text shown at the bottom of the login page.
# The value is sanitized server-side: only <a> tags are allowed.
# Allowed href schemes are: https, http, and mailto.
# All other tags/attributes are removed.
# Example: 'If you have problems, please contact <a href="mailto:support@example.org">support</a>.'
support_text = ""

# ----------------------------------------------------------------------------
# PAM Authentication Configuration (when auth_mode = "pam" or "both")
# ----------------------------------------------------------------------------
[controller.pam]

# PAM service name to use for authentication
service_name = "carta"

# ----------------------------------------------------------------------------
# OIDC Authentication Configuration (when auth_mode = "oidc" or "both")
# ----------------------------------------------------------------------------
[controller.oidc]

# OIDC issuer URL
issuer_url = ""

# OIDC client ID registered with your identity provider
client_id = ""

# OIDC client secret
client_secret = ""

# OIDC redirect/callback URL
# Example: "http://localhost:8081/api/auth/oidc_callback"
redirect_url = ""

# Path to a file containing the key used to encrypt OIDC offline tokens before
# they are stored in the database for device sessions. The file must contain
# the raw key bytes (32 bytes for AES-256-GCM), e.g. generated with:
#   head -c 32 /dev/urandom > /etc/carta/oidc_encryption.key
# This is required to support OIDC device sessions. Leave empty to disable
# OIDC device sessions.
encryption_key_file = ""

# Public application URL used for OIDC logout redirects after sign-out.
# Example: "http://localhost:8081/login"
app_url = ""

# ----------------------------------------------------------------------------
# JWT Token Configuration
# ----------------------------------------------------------------------------
[controller.token_config]

# PEM-encoded private key used to sign CARTA JWTs.
# Defaults to /etc/carta/carta_private.pem if omitted.
private_key_location = "/etc/carta/carta_private.pem"

# PEM-encoded public key used to verify CARTA JWTs.
# Defaults to /etc/carta/carta_public.pem if omitted.
public_key_location = "/etc/carta/carta_public.pem"

# Issuer claim written into generated CARTA JWTs.
issuer = "carta-ctl"

# Lifetime of short-lived access tokens.
access_token_age = "10m"

# Lifetime of refresh tokens.
refresh_token_age = "24h"

# ----------------------------------------------------------------------------
# Device Authorization Configuration
# ----------------------------------------------------------------------------
[controller.device_auth]

# How long a pending device login (and its device code) remains valid.
lifetime = "10m"

# Minimum time a client must wait between polls for the login result.
min_interval = "5s"

# Maximum lifetime of a device key registration. The CLI can refresh its
# access tokens for this long; after it expires the user must log in again.
# For OIDC device sessions, each issued access token is additionally capped at
# the expiry of the most recently retrieved upstream OIDC access token.
max_refresh_interval = "24h"

# Public base URL of this server, used to build the verification link shown to
# the user (e.g. "https://carta.example.org"). Must be an absolute http(s) URL.
# Required for device authorization: the controller refuses to start without it
# so verification links cannot be poisoned via a spoofed Host header.
public_url = ""

# How often expired pending device logins are purged from the database. If
# empty, this defaults to half of `lifetime` (every 5m for the default 10m
# lifetime). This is a background maintenance interval, not the polling rate.
pending_purge_interval = ""

# How often expired or revoked device sessions are purged from the database. If
# empty, this defaults to `max_refresh_interval` / 24 (hourly for the default
# 24h registration lifetime). This is a background maintenance interval.
session_purge_interval = ""

# Maximum number of pending (unexpired, unlinked) device logins allowed from a
# single client IP address. Set to 0 to disable the limit. The default is
# generous because a controller may run on a compute cluster where many users
# share one egress IP; raise it if legitimate multi-user logins are rejected.
max_pending_per_ip = 10

# When non-empty, the client IP used for device-init rate limiting is read from
# this request header (e.g. "X-Forwarded-For" or "X-Real-IP") instead of the
# peer address. Only set this when the controller is behind a trusted reverse
# proxy; the header is otherwise client-controlled and can bypass the limit.
client_ip_header = ""

# ============================================================================
# Spawner Configuration
# ============================================================================
[spawner]

# Path or command to the CARTA backend executable
worker_exec = "carta_backend"

# Timeout duration for spawning worker processes
timeout = "5s"

# Port for the spawner HTTP server
port = 8080

# Hostname to bind to. If this is empty, all interfaces will be used
hostname = ""

# Base directory for user data access
# 
# References to {{{.user}}} in the string will be replaced with the username of the user
# and "{{.home}}" will be replaced by the user's home directory
base_dir_tmpl = "{{.home}}"

# Top level directory for user data access
top_level_dir = "/"
